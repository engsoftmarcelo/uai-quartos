// ---------------------------------------------------------
// PROJETO: UAI QUARTOS - TERÇA-FEIRA, 24 DE MARÇO
// ARTEFATO: Schema Relacional Final c/ Dinâmica Geoespacial
// ---------------------------------------------------------

generator client {
  provider        = "prisma-client-js"
  // Habilita as extensões do PostgreSQL (como o PostGIS)
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // Instala a extensão PostGIS versão 3 no banco de dados
  extensions = [postgis]
}

// ==========================================
// ENUMS DE DOMÍNIO
// ==========================================
enum Role {
  STUDENT
  LANDLORD
  ADMIN
}

enum KycStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  APPROVED
  CONTRACT_PENDING
  CONTRACT_SIGNED
  SETTLED
  FAILED
  REFUNDED
  CANCELED
}

enum KycDocumentType {
  RG
  CNH
  PASSPORT
  STUDENT_ID
}

enum SplitCalculationType {
  PERCENTAGE
  FIXED
}

enum RecipientStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum LedgerAccount {
  STUDENT_RECEIVABLE
  IUGU_CLEARING
  PLATFORM_REVENUE
  LANDLORD_PAYABLE
  CONTRACT_ESCROW
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

enum LegalAgreementStatus {
  DRAFT
  SENT
  SIGNED
  CANCELED
}

enum ProviderEventStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

// ==========================================
// 1. IDENTIDADE (IAM & KYC) com Soft Deletes
// ==========================================
model User {
  id        String    @id @default(uuid())
  email     String    @unique
  name      String
  password  String
  role      Role      @default(STUDENT)
  kycStatus KycStatus @default(PENDING) @map("kyc_status")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  profile               Profile?
  republics             Republic[]
  reservations          Reservation[]
  sessions              AuthSession[]
  kycDocuments          KycDocument[]
  studentConversations  Conversation[]    @relation("StudentConversations")
  landlordConversations Conversation[]    @relation("LandlordConversations")
  sentMessages          Message[]         @relation("SentMessages")
  paymentRecipient      PaymentRecipient?

  @@map("users")
}

model Profile {
  id     String @id @default(uuid())
  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  noiseLevel       Int     @default(5) @map("noise_level")
  organization     Int     @default(5)
  visitorPolicy    Int     @default(5) @map("visitor_policy")
  sleepRoutine     Int     @default(5) @map("sleep_routine")
  isPetFriendly    Boolean @default(false) @map("is_pet_friendly")
  isSmoker         Boolean @default(false) @map("is_smoker")
  preferenceVector Float[] @default([]) @map("preference_vector")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("profiles")
}

// ==========================================
// 2. INVENTÁRIO IMOBILIÁRIO & MAPA VETORIAL
// ==========================================
model Republic {
  id      String @id @default(uuid())
  ownerId String @map("owner_id")
  owner   User   @relation(fields: [ownerId], references: [id])

  name         String
  description  String? @db.Text
  address      String?
  neighborhood String?
  city         String?
  state        String? @default("MG")
  postalCode   String? @map("postal_code")
  imageUrl     String? @map("image_url") @db.Text

  // ARQUITETURA ESPACIAL: SRID 4326 (Padrão WGS84 - GPS)
  location Unsupported("geometry(Point, 4326)")?

  rooms         Room[]
  photos        PropertyPhoto[]
  conversations Conversation[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // ÍNDICE GIST: Ativa a matemática de Árvore R (R-Tree) para buscas de proximidade instantâneas
  @@index([location], type: Gist)
  @@map("republics")
}

model Room {
  id         String   @id @default(uuid())
  republicId String   @map("republic_id")
  republic   Republic @relation(fields: [republicId], references: [id], onDelete: Cascade)

  title           String
  basePrice       Decimal  @map("base_price") @db.Decimal(10, 2)
  isAvailable     Boolean  @default(true) @map("is_available")
  privateBathroom Boolean  @default(false) @map("private_bathroom")
  capacity        Int      @default(1)
  areaM2          Decimal? @map("area_m2") @db.Decimal(5, 2)

  amenities    Amenity[]
  reservations Reservation[]

  @@map("rooms")
}

model Amenity {
  id    String @id @default(uuid())
  name  String @unique
  rooms Room[]

  @@map("amenities")
}

model PropertyPhoto {
  id         String   @id @default(uuid())
  republicId String   @map("republic_id")
  republic   Republic @relation(fields: [republicId], references: [id], onDelete: Cascade)
  storageKey String   @unique @map("storage_key")
  imageUrl   String?  @map("image_url") @db.Text
  altText    String?  @map("alt_text")
  position   Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([republicId])
  @@map("property_photos")
}

// ==========================================
// 3. MOTOR FINANCEIRO & SPLIT (Checkout B2B)
// ==========================================
model Reservation {
  id          String     @id @default(uuid())
  studentId   String     @map("student_id")
  student     User       @relation(fields: [studentId], references: [id])
  roomId      String     @map("room_id")
  room        Room       @relation(fields: [roomId], references: [id])
  splitRuleId String?    @map("split_rule_id")
  splitRule   SplitRule? @relation(fields: [splitRuleId], references: [id])

  grossValue  Decimal @map("gross_value") @db.Decimal(10, 2)
  platformFee Decimal @map("platform_fee") @db.Decimal(10, 2)
  netValue    Decimal @map("net_value") @db.Decimal(10, 2)

  idempotencyKey   String?               @unique @map("idempotency_key")
  iuguInvoiceId    String?               @unique @map("iugu_invoice_id")
  iuguPixCode      String?               @map("iugu_pix_code") @db.Text
  iuguSplitPayload Json?                 @map("iugu_split_payload")
  paymentExpiresAt DateTime?             @map("payment_expires_at")
  status           PaymentStatus         @default(PENDING)
  paymentSplit     PaymentSplit?
  ledgerEntries    LedgerEntry[]
  webhookEvents    FinanceWebhookEvent[]
  legalAgreement   LegalAgreement?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  paidAt    DateTime? @map("paid_at")

  @@index([studentId])
  @@index([roomId])
  @@index([splitRuleId])
  @@index([iuguInvoiceId])
  @@index([status])
  @@map("reservations")
}

model SplitRule {
  id             String         @id @default(uuid())
  platformFeePct Decimal        @map("platform_fee_pct") @db.Decimal(5, 2)
  activeFrom     DateTime       @default(now()) @map("active_from")
  activeUntil    DateTime?      @map("active_until")
  reservations   Reservation[]
  paymentSplits  PaymentSplit[]

  @@map("split_rules")
}

model PaymentRecipient {
  id                String          @id @default(uuid())
  userId            String          @unique @map("user_id")
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String          @default("IUGU_SANDBOX")
  providerAccountId String          @unique @map("provider_account_id")
  legalName         String          @map("legal_name")
  document          String
  bankCode          String?         @map("bank_code")
  agency            String?
  accountNumber     String?         @map("account_number")
  pixKey            String?         @map("pix_key")
  status            RecipientStatus @default(PENDING)
  paymentSplits     PaymentSplit[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@map("payment_recipients")
}

model PaymentSplit {
  id              String               @id @default(uuid())
  reservationId   String               @unique @map("reservation_id")
  reservation     Reservation          @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  recipientId     String               @map("recipient_id")
  recipient       PaymentRecipient     @relation(fields: [recipientId], references: [id])
  splitRuleId     String?              @map("split_rule_id")
  splitRule       SplitRule?           @relation(fields: [splitRuleId], references: [id])
  calculationType SplitCalculationType @map("calculation_type")
  platformFeePct  Decimal              @map("platform_fee_pct") @db.Decimal(5, 2)
  platformAmount  Decimal              @map("platform_amount") @db.Decimal(10, 2)
  landlordAmount  Decimal              @map("landlord_amount") @db.Decimal(10, 2)
  providerPayload Json                 @map("provider_payload")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([recipientId])
  @@index([splitRuleId])
  @@map("payment_splits")
}

model LedgerEntry {
  id             String          @id @default(uuid())
  reservationId  String          @map("reservation_id")
  reservation    Reservation     @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  account        LedgerAccount
  direction      LedgerDirection
  amount         Decimal         @db.Decimal(10, 2)
  currency       String          @default("BRL")
  idempotencyKey String          @unique @map("idempotency_key")
  description    String
  metadata       Json?
  createdAt      DateTime        @default(now()) @map("created_at")

  @@index([reservationId])
  @@index([account])
  @@map("ledger_entries")
}

model FinanceWebhookEvent {
  id            String              @id @default(uuid())
  provider      String
  eventKey      String              @unique @map("event_key")
  eventType     String              @map("event_type")
  signature     String?
  payload       Json
  status        ProviderEventStatus @default(RECEIVED)
  reservationId String?             @map("reservation_id")
  reservation   Reservation?        @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  processedAt   DateTime?           @map("processed_at")
  createdAt     DateTime            @default(now()) @map("created_at")

  @@index([provider])
  @@index([reservationId])
  @@index([status])
  @@map("finance_webhook_events")
}

model LegalAgreement {
  id                  String               @id @default(uuid())
  reservationId       String               @unique @map("reservation_id")
  reservation         Reservation          @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  provider            String               @default("CLICKSIGN_SANDBOX")
  providerDocumentId  String               @unique @map("provider_document_id")
  documentKey         String               @unique @map("document_key")
  status              LegalAgreementStatus @default(SENT)
  signatureRequestUrl String?              @map("signature_request_url") @db.Text
  studentEmail        String               @map("student_email")
  landlordEmail       String               @map("landlord_email")
  payload             Json
  sentAt              DateTime             @default(now()) @map("sent_at")
  signedAt            DateTime?            @map("signed_at")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  @@index([status])
  @@map("legal_agreements")
}

model AuthSession {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  replacedByHash   String?   @map("replaced_by_hash")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("auth_sessions")
}

model KycDocument {
  id           String          @id @default(uuid())
  userId       String          @map("user_id")
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentType KycDocumentType @map("document_type")
  storageKey   String          @unique @map("storage_key")
  filename     String
  contentType  String          @map("content_type")
  status       KycStatus       @default(PENDING)
  reviewedAt   DateTime?       @map("reviewed_at")
  createdAt    DateTime        @default(now()) @map("created_at")

  @@index([userId])
  @@index([status])
  @@map("kyc_documents")
}

model Conversation {
  id         String   @id @default(uuid())
  propertyId String   @map("property_id")
  property   Republic @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  studentId  String   @map("student_id")
  student    User     @relation("StudentConversations", fields: [studentId], references: [id])
  landlordId String   @map("landlord_id")
  landlord   User     @relation("LandlordConversations", fields: [landlordId], references: [id])

  messages  Message[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@unique([propertyId, studentId, landlordId])
  @@index([studentId])
  @@index([landlordId])
  @@index([propertyId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String       @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String       @map("sender_id")
  sender         User         @relation("SentMessages", fields: [senderId], references: [id])
  body           String       @db.Text
  eventId        String?      @unique @map("event_id")
  deliveredAt    DateTime?    @map("delivered_at")
  readAt         DateTime?    @map("read_at")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("messages")
}
